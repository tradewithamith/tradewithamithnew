# GEMINI_API_KEY: Optional runtime key injected by AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Optional server-side YouTube Data API v3 key for public subscriber count lookup.
YOUTUBE_API_KEY=""

# VAPID_PUBLIC_KEY & VAPID_PRIVATE_KEY: Optional Web Push VAPID keys (auto-generated and stored in Firestore if unset).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
